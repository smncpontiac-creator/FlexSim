tree MainTree {
    tree gui {
        tree windowmenu {
        }
    }
    tree model {
        tree ModelSettings {
            int units: 1  // Metric
            int timeunits: 1  // Seconds
            tree spatial {
                num x: 0
                num y: 0
                num z: 0
                num rx: 0
                num ry: 0
                num rz: 0
            }
            tree variables {
                num warmuptime: 0
                num runspeed: 1
                num stoptime: 28800  // 8 hours simulation
            }
        }

        // FLOOR (Piso de la bodega - 25m x 15m)
        tree Floor {
            int objectfocus: 1
            tree spatial {
                num x: 12.5
                num y: 7.5
                num z: 0
                num sx: 25
                num sy: 15
                num sz: 0.1
            }
            tree variables {
                string colorcode: "0x808080FF"  // Gray floor
            }
        }

        // ============================================
        // ZONA DE ENTRADA/SALIDA
        // ============================================
        tree Source_Recepcion {
            int objectfocus: 2
            string class: "Source"
            tree spatial {
                num x: 2
                num y: 7.5
                num z: 0
                num sx: 1
                num sy: 1
                num sz: 1
            }
            tree variables {
                num interarrivaltime: 300  // Un pallet cada 5 minutos
                string itemtype: "Pallet"
            }
        }

        tree Queue_Recepcion {
            int objectfocus: 3
            string class: "Queue"
            tree spatial {
                num x: 4
                num y: 7.5
